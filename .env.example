# Database (Railway PostgreSQL plugin provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/workforge

# Auth — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=WorkForge <notifications@yourdomain.com>

# SMS (Twilio — https://twilio.com)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# Layer 3 Agent (Anthropic Claude — https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
AGENT_SECRET=change-this-to-a-long-random-secret
AGENT_DIGEST_EMAIL=prios0815@gmail.com
