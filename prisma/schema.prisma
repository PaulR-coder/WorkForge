generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  admin
  dispatcher
  tech
  readonly
}

enum JobStatus {
  open
  scheduled
  in_progress
  done
}

enum Priority {
  low
  normal
  high
  urgent
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum EstimateStatus {
  draft
  sent
  approved
  declined
}

enum PaymentMethod {
  card
  cash
  check
  digital
}

enum AuditSeverity {
  info
  warn
  error
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String   @default("trialing")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?

  users             User[]
  jobs              Job[]
  invoices          Invoice[]
  payments          Payment[]
  equipment         Equipment[]
  contracts         Contract[]
  messages          Message[]
  auditLogs         AuditLog[]
  notificationRules NotificationRule[]
  invites           Invite[]
  estimates         Estimate[]
  timeEntries       TimeEntry[]
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      Role      @default(tech)
  token     String    @unique
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([token])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(tech)
  initials  String
  company   String   @default("")
  specialty String   @default("")
  phone     String?
  active          Boolean   @default(true)
  lat             Float?
  lng             Float?
  locatedAt       DateTime?
  sharingLocation Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailVerified    Boolean   @default(true)
  verifyToken      String?   @unique
  verifyTokenExpiry DateTime?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  twoFactorSecret    String?
  twoFactorEnabled   Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  assignedJobs      Job[]              @relation("AssignedTech")
  payments          Payment[]
  auditLogs         AuditLog[]
  messages          Message[]
  photos            Photo[]
  pushSubscriptions PushSubscription[]
  estimates         Estimate[]         @relation("EstimateCreatedBy")
  timeEntries       TimeEntry[]        @relation("TechTimeEntries")

  @@index([tenantId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Job {
  id          String    @id @default(cuid())
  client      String
  address     String
  description String    @default("")
  type        String
  priority    Priority  @default(normal)
  status      JobStatus @default(open)
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  techId     String?
  tech       User?     @relation("AssignedTech", fields: [techId], references: [id])
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])

  archivedAt DateTime?
  deletedAt  DateTime?

  invoices    Invoice[]
  payments    Payment[]
  messages    Message[]
  photos      Photo[]
  equipment   Equipment[] @relation("JobEquipment")
  estimate    Estimate?
  timeEntries TimeEntry[]

  @@index([tenantId])
  @@index([techId])
  @@index([contractId])
  @@index([status])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  client      String
  clientEmail String        @default("")
  jobId       String?
  job       Job?          @relation(fields: [jobId], references: [id])
  labor     Float         @default(0)
  parts     Float         @default(0)
  surcharge Float         @default(0)
  total     Float
  status    InvoiceStatus @default(draft)
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  payments Payment[]

  @@index([tenantId])
  @@index([jobId])
  @@index([status])
  @@index([tenantId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  jobId         String?
  job           Job?          @relation(fields: [jobId], references: [id])
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  collectedById String
  collectedBy   User          @relation(fields: [collectedById], references: [id])
  method        PaymentMethod
  amount        Float
  cashTendered  Float?
  changeDue     Float?
  checkNumber   String?
  signature     String?       @db.Text
  notes         String        @default("")
  createdAt     DateTime      @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([jobId])
  @@index([tenantId, createdAt])
}

model Equipment {
  id            String    @id @default(cuid())
  client        String
  name          String
  brand         String
  model         String
  serialNumber  String
  icon          String    @default("⚙")
  installedAt   DateTime
  warrantyEnd   DateTime?
  intervalDays  Int       @default(90)
  lastPMDaysAgo Int       @default(0)
  totalServices Int       @default(0)
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  jobs Job[] @relation("JobEquipment")

  @@index([tenantId])
}

model Contract {
  id            String   @id @default(cuid())
  client        String
  name          String
  icon          String   @default("📑")
  units         Int      @default(1)
  techInitials  String   @default("")
  frequencyDays Int      @default(90)
  pricePerVisit Float
  nextDueDate   DateTime
  jobsCompleted Int      @default(0)
  active        Boolean  @default(true)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  jobs Job[]

  @@index([tenantId])
}

model Message {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([jobId])
}

model NotificationRule {
  id          String   @id @default(cuid())
  icon        String   @default("🔔")
  title       String
  description String
  template    String   @db.Text
  channel     String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AuditLog {
  id        String        @id @default(cuid())
  icon      String
  action    String
  detail    String
  severity  AuditSeverity @default(info)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([tenantId, createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  data      String   @db.Text
  mimeType  String   @default("image/jpeg")
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Estimate {
  id                  String         @id @default(cuid())
  number              String         @unique
  client              String
  clientEmail         String         @default("")
  jobType             String         @default("")
  description         String         @default("")
  lineItems           Json           @default("[]")
  subtotal            Float          @default(0)
  status              EstimateStatus @default(draft)
  notes               String         @default("")
  approvalToken       String?        @unique
  approvalTokenExpiry DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  createdById String
  createdBy   User           @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  jobId       String?        @unique
  job         Job?           @relation(fields: [jobId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([createdById])
  @@index([approvalToken])
}

model TimeEntry {
  id        String    @id @default(cuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  techId    String
  tech      User      @relation("TechTimeEntries", fields: [techId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?
  notes     String    @default("")
  createdAt DateTime  @default(now())

  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([jobId])
  @@index([techId])
  @@index([tenantId])
}
